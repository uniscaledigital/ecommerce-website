# The Irish Grocer - Headless Commerce Configuration (Hydrogen 2026-10 Ready)

# Operating Mode: "demo" (local mock data & simulated cart) or "production" (live Shopify Storefront API)
NEXT_PUBLIC_COMMERCE_MODE=demo

# Shopify Store Domain (e.g., the-irish-grocer.myshopify.com)
# Obtain from Shopify Admin > Settings > Domains
SHOPIFY_STORE_DOMAIN=the-irish-grocer.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=the-irish-grocer.myshopify.com

# Shopify Storefront API Public Access Token
# SAFE for client-side or public server queries.
# Obtain from Shopify Admin > Headless sales channel > Storefront API
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here

# Shopify Storefront API Version (Standardized stable Storefront API version)
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Shopify Private Storefront Token (Optional - Server-side only, NEVER prefix with NEXT_PUBLIC_)
# Used for privileged backend operations, server actions, or webhooks
SHOPIFY_PRIVATE_STOREFRONT_TOKEN=your_private_storefront_token_here

# Shopify Customer Account API Client ID (Required for modern OAuth PKCE customer accounts)
# Obtain from Shopify Admin > Settings > Customer accounts > Headless authentication
NEXT_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id_here

# Base URL for local development and production routing / redirect URIs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store Contact and Enquiry Dispatch (Marshfield Store)
STORE_CONTACT_EMAIL=irishgrocer@gmail.com
STORE_CONTACT_PHONE=+1 (774) 699-0889
STORE_ADDRESS=1899 Ocean St, Marshfield, Massachusetts

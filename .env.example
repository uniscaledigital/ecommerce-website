# The Irish Grocer - Headless Commerce Configuration

# Operating Mode: "demo" (mock data, local cart simulation) or "production" (live Shopify API)
NEXT_PUBLIC_COMMERCE_MODE=demo

# Shopify Storefront API Configuration (Required for Production Mode)
# Example: the-irish-grocer.myshopify.com
SHOPIFY_STORE_DOMAIN=the-irish-grocer.myshopify.com

# Shopify Storefront API Access Token (Public Token)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here

# Shopify Storefront API Version (Pinned to Stable 2025-01)
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Shopify Private Storefront / Admin Token (Server-side requests only, never exposed to browser)
SHOPIFY_PRIVATE_STOREFRONT_TOKEN=your_private_storefront_token_here

# Shopify Customer Account API Client ID (Required for Customer Account API)
NEXT_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id_here

# Base URL for local development and production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store Contact and Enquiry Dispatch (Quincy Store)
STORE_CONTACT_EMAIL=theirishgrocer@gmail.com
STORE_CONTACT_PHONE=+1 (857) 387-2065
STORE_ADDRESS=132 East Howard Street, Quincy, MA 02169

